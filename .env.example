# Скопіюй цей файл як ".env" (без .example) і встав свій ключ.
# Ключ створюється на https://console.anthropic.com -> API Keys.
# Файл .env у git не потрапляє (.gitignore).
ANTHROPIC_API_KEY=sk-ant-api03-...

# Вправи "🤖 Переклади з української" (необов'язково). Ключ — на https://openrouter.ai -> Keys,
# модель — її id зі сторінки моделі на OpenRouter.
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=
